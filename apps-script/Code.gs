const SHEETS = { participants:'Participants', responses:'Responses', progress:'ModuleProgress', errors:'ErrorLogs' };
function doPost(e){try{const body=JSON.parse(e.postData.contents||'{}');const action=body.action;const payload=body.payload||{};let data={};if(action==='ping')data={app:'C1BIO_AI_LEADERSHIP_LAB',serverTime:new Date().toISOString()};else if(action==='setupSheetsC1Bio')data=setupSheetsC1Bio();else if(action==='saveParticipant')data=append_(SHEETS.participants,payload);else if(action==='saveResponse')data=append_(SHEETS.responses,payload);else if(action==='saveProgress')data=append_(SHEETS.progress,payload);else if(action==='getDashboardData')data=getDashboardData(payload);else if(action==='logError')data=append_(SHEETS.errors,payload);else throw new Error('Unknown action: '+action);return json_({ok:true,action,data,message:'success'});}catch(err){return json_({ok:false,error:String(err&&err.message?err.message:err)});}}
function setupSheetsC1Bio(){const ss=SpreadsheetApp.getActive();ensure_(ss,SHEETS.participants,['participantId','sessionCode','name','teamName','role','consentChecked','createdAt','updatedAt','userAgent']);ensure_(ss,SHEETS.responses,['responseId','participantId','sessionCode','teamName','moduleId','screenId','activityId','activityName','inputData','outputData','promptText','aiAnswerText','reviewData','finalText','isCompleted','createdAt','updatedAt']);ensure_(ss,SHEETS.progress,['participantId','sessionCode','teamName','moduleId','status','lastScreenId','completedScreenCount','totalScreenCount','updatedAt']);ensure_(ss,SHEETS.errors,['logId','sessionCode','participantId','action','errorMessage','payload','createdAt']);return {sheets:Object.values(SHEETS)};}
function ensure_(ss,name,headers){let sh=ss.getSheetByName(name)||ss.insertSheet(name);if(sh.getLastRow()===0)sh.appendRow(headers);return sh;}
function append_(name,obj){const ss=SpreadsheetApp.getActive();const sh=ss.getSheetByName(name);if(!sh)throw new Error('Sheet not found: '+name);const headers=sh.getRange(1,1,1,sh.getLastColumn()).getValues()[0];sh.appendRow(headers.map(h=>typeof obj[h]==='object'?JSON.stringify(obj[h]):(obj[h]||'')));return {saved:true};}
function getDashboardData(payload){const ss=SpreadsheetApp.getActive();const out={};[SHEETS.participants,SHEETS.responses,SHEETS.progress].forEach(name=>{const sh=ss.getSheetByName(name);if(!sh){out[name]=[];return;}const values=sh.getDataRange().getValues();const headers=values.shift()||[];out[name]=values.map(r=>Object.fromEntries(headers.map((h,i)=>[h,r[i]]))).filter(x=>!payload.sessionCode||x.sessionCode===payload.sessionCode);});return out;}
function json_(obj){return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);}
