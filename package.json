{
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "npm run typecheck:v35",
    "typecheck:v35": "tsc -p tsconfig.v35-smoke.json --noEmit",
    "typecheck:v36": "tsc -p tsconfig.v36-smoke.json --noEmit",
    "typecheck:v38": "tsc -p tsconfig.v38-smoke.json --noEmit",
    "typecheck:v39": "tsc -p tsconfig.v39-smoke.json --noEmit",
    "typecheck:v40-lite": "tsc -p tsconfig.v40-lite-smoke.json --noEmit",
    "typecheck:v40-vnext": "tsc -p tsconfig.v40-vnext-smoke.json --noEmit",
    "typecheck:full": "tsc --noEmit",
    "smoke:v35:static": "node scripts/smoke-v35-static.mjs",
    "smoke:v35:dist": "node scripts/smoke-v35-dist.mjs",
    "smoke:v35:remote": "node scripts/smoke-v35-remote.mjs",
    "preflight:v35:cutover": "node scripts/preflight-v35-cutover.mjs",
    "audit:v35:readiness": "node scripts/audit-v35-readiness.mjs",
    "smoke:v35": "npm run smoke:v35:static && npm run typecheck:v35 && npm run build && npm run smoke:v35:dist && npm run preflight:v35:cutover",
    "smoke:v36:static": "node scripts/smoke-v36-static.mjs",
    "smoke:v36:dist": "node scripts/smoke-v36-dist.mjs",
    "smoke:v36": "npm run smoke:v36:static && npm run typecheck:v36 && npm run build && npm run smoke:v36:dist",
    "smoke:v38:static": "node scripts/smoke-v38-static.mjs",
    "smoke:v38:dist": "node scripts/smoke-v38-dist.mjs",
    "smoke:v38": "npm run smoke:v38:static && npm run typecheck:v38 && npm run build && npm run smoke:v38:dist",
    "smoke:v39:static": "node scripts/smoke-v39-static.mjs",
    "smoke:v39:dist": "node scripts/smoke-v39-dist.mjs",
    "smoke:v39:local-preview": "node scripts/smoke-v39-local-preview.mjs",
    "smoke:v39:remote": "node scripts/smoke-v39-remote.mjs",
    "audit:v39:readiness": "node scripts/audit-v39-readiness.mjs",
    "smoke:v39": "npm run smoke:v39:static && npm run audit:v39:readiness && npm run typecheck:v39 && npm run build && npm run smoke:v39:dist && npm run smoke:v39:local-preview",
    "smoke:v40-lite:static": "node scripts/smoke-v40-lite-static.mjs",
    "smoke:v40-lite": "npm run smoke:v40-lite:static && npm run typecheck:v40-lite && npm run build",
    "smoke:v40-vnext:static": "node scripts/smoke-v40-vnext-static.mjs && node scripts/smoke-v40-vnext-parser.mjs",
    "audit:linebreaks": "node scripts/audit-content-line-breaks.mjs",
    "smoke:parser": "node scripts/smoke-ai-result-parser.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.4.49",
    "autoprefixer": "^10.4.20"
  }
}
